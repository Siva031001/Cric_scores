rules_version = '2';

// CricketScorer image uploads. There was previously NO storage.rules file
// in this project at all, so `firebase deploy` never pushed any Storage
// permissions — uploads were relying on whatever default rules exist on the
// live project (default is deny-all), which is the likely cause of image
// uploads failing across the app (profile photo, team logo, tournament
// banner). Each path below matches exactly what src/utils/firebase.ts's
// uploadLocalImageToStorage() writes to.
service firebase.storage {
  match /b/{bucket}/o {

    match /profile_photos/{fileName} {
      allow read: if true;
      // Only the signed-in user can write their own photo — the app always
      // names the file "<uid>.jpg".
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /team_logos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /tournament_banners/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
